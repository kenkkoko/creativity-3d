# 模型提供者：ollama（本機）或 fake（測試／離線）
PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=bge-m3
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# 產品參數
ANSWER_SECONDS=180
PERCENTILE_MIN_USERS=20
RARITY_MIN_USERS=5
SIMILAR_THRESHOLD=0.85
MAX_CUSTOM_STIMULI_PER_DAY=5

# 伺服器
HOST=127.0.0.1
PORT=8000

# 合理性門檻：false = AI 不擋答案（只有亂打、重複、指令會擋）；true = AI 判不合理就不計分
APPROPRIATENESS_GATE=false
